rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Public Read / Admin Write Collections
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /testimonials/{tId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders
    // Anyone can create (public checkout)
    // Only owner (by email match) or Admin can read
    match /orders/{orderId} {
      allow create: if true;
      allow read: if request.auth != null && (resource.data.email == request.auth.token.email || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Messages (Contact Form)
    match /messages/{msgId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Users
    // Users can read/write ONLY their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}