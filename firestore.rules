rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    // Check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user is an admin by looking up their user profile in Firestore
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Check if the user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Prevent users from changing their role (Privilege Escalation protection)
    function isNotChangingRole() {
      // Allow update if 'role' field is NOT present in the request (unchanged)
      // OR if the 'role' field in request matches the existing resource
      return !('role' in request.resource.data) || request.resource.data.role == resource.data.role;
    }

    // --- Catalog & Content (Public Read, Admin Write) ---

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- User Interaction ---

    // Messages (Contact Form)
    // Public can create, Admin can read/manage
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Orders
    // Public can create (Guest Checkout)
    // Admins can manage all
    // Users can read their own orders based on the 'email' field stored in the order
    match /orders/{orderId} {
      allow create: if true;
      // Allow read if Admin OR if the order belongs to the logged-in user's email
      allow read: if isAdmin() || (isAuthenticated() && resource.data.email == request.auth.token.email);
      allow update, delete: if isAdmin();
    }

    // --- User Profiles ---

    match /users/{userId} {
      // 1. Read: Owner or Admin
      allow read: if isOwner(userId) || isAdmin();
      
      // 2. Create: User creates their own profile on registration
      allow create: if isOwner(userId);
      
      // 3. Update: 
      // - Admin can update anything.
      // - Owner can update ONLY if they are NOT changing the 'role' field.
      allow update: if isAdmin() || (isOwner(userId) && isNotChangingRole());
      
      // 4. Delete: Only Admin
      allow delete: if isAdmin();
    }
  }
}