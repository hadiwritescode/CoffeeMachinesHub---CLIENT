
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Public Read Access for all uploaded files (Images, etc.)
      allow read: if true;

      // Restrict writes to authenticated users.
      // Ideally, you would check for admin status here using Custom Claims,
      // but standard Firestore lookups are not supported in Storage rules.
      // This basic rule prevents unauthenticated uploads.
      allow write: if request.auth != null;
    }
  }
}
